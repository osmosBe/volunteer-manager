APP_NAME="ST. PRIDE Volunteer Management"
APP_VERSION="local"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./volunteer.db"
APP_BASE_URL="http://localhost:8000"
AUTH_MODE="disabled"
# Required when AUTH_MODE=disabled outside development/test. Never expose this
# mode to an untrusted network.
ALLOW_INSECURE_AUTH="false"
DEBUG="true"
SEED_DEMO_DATA="false"

# PostgreSQL example (escape special password characters as URL components):
# DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:5432/volunteer?sslmode=require"

# EasyAuth (AUTH_MODE=easyauth) needs no generic OIDC secret. Authorization
# mappings are managed in the application database at /admin/permissions.

# Generic OpenID Connect (AUTH_MODE=oidc). SESSION_SECRET must be a long random
# value and .env must be protected; never commit a real client secret.
SESSION_SECRET=""
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email"
OIDC_ROLE_CLAIMS="roles"
OIDC_GROUP_CLAIMS="groups"
OIDC_USER_ID_CLAIM="sub"
OIDC_NAME_CLAIM="name"
OIDC_EMAIL_CLAIMS="email,preferred_username"

# SMTP passwords stay in environment/Azure secrets, never in the database.
SMTP_PASSWORD=""

# Transactional mail defaults to a non-sending provider. MAIL_FROM_ADDRESS is
# required only when a message is explicitly sent (including the admin test).
MAIL_PROVIDER="console"
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="ST. PRIDE Volunteer Manager"
MAIL_REPLY_TO=""

# Microsoft Graph app-only settings (only used with MAIL_PROVIDER=graph).
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_AUTH_MODE="client_secret"
# M365_CLIENT_SECRET must be an Azure Container App secret in Azure.
M365_CLIENT_SECRET=""
