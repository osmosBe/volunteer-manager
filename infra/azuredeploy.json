  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "volunteer",
      "minLength": 3,
      "maxLength": 18,
      "metadata": {
        "description": "Short lowercase prefix used to generate resource names."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "production"
      ],
      "metadata": {
        "description": "Deployment environment label."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Existing resources must be in a compatible region."
      }
    },
    "existingContainerAppEnvironmentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing Container Apps environment to preserve and reuse. Leave empty to create one."
      }
    },
    "existingContainerRegistryName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing Azure Container Registry to preserve and reuse. Leave empty to create one."
      }
    },
    "existingContainerAppName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing Container App to preserve. Leave empty to create a bootstrap app."
      }
    },
    "existingPostgresServerName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing PostgreSQL Flexible Server to reuse. Leave empty to create one."
      }
    },
    "postgresqlAdministratorLogin": {
      "type": "string",
      "defaultValue": "volunteeradmin",
      "metadata": {
        "description": "PostgreSQL administrator login."
      }
    },
    "postgresqlAdministratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Strong PostgreSQL administrator password. This is stored only in Azure resource secrets."
      }
    },
    "bootstrapImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
      "metadata": {
        "description": "Initial public bootstrap image. GitHub Actions replaces it with the application image."
      }
    },
    "deployStorage": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create a storage account for future files/exports. It is not used for the database."
      }
    },
    "demoMode": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Show a global warning that the application is running in demo mode."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "Volunteer Manager",
      "metadata": {
        "description": "Application name shown in page titles and administration views."
      }
    },
    "mailProvider": {
      "type": "string",
      "defaultValue": "console",
      "allowedValues": [
        "console",
        "graph"
      ],
      "metadata": {
        "description": "Transactional mail provider. Console performs no external delivery."
      }
    },
    "mailFromAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Configured sender/shared mailbox address. Required before sending mail."
      }
    },
    "mailFromName": {
      "type": "string",
      "defaultValue": "Volunteer Manager",
      "metadata": {
        "description": "Display name used for transactional mail."
      }
    },
    "mailReplyTo": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Reply-To address."
      }
    },
    "m365TenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Microsoft 365 tenant ID. Required only for the Graph provider."
      }
    },
    "m365ClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Entra application client ID. Required only for the Graph provider."
      }
    },
    "m365AuthMode": {
      "type": "string",
      "defaultValue": "client_secret",
      "allowedValues": [
        "client_secret",
        "managed_identity"
      ],
      "metadata": {
        "description": "Graph credential mode. Managed Identity is reserved for future support."
      }
    },
    "m365ClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Entra client secret. Stored only as a Container App secret; leave empty for console mode."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(subscription().subscriptionId, resourceGroup().id, parameters('namePrefix'))]",
    "normalizedPrefix": "[toLower(replace(parameters('namePrefix'), '-', ''))]",
    "generatedEnvironmentName": "[format('{0}-{1}-env', parameters('namePrefix'), parameters('environmentName'))]",
    "generatedRegistryName": "[take(format('{0}{1}{2}', variables('normalizedPrefix'), parameters('environmentName'), variables('suffix')), 50)]",
    "generatedAppName": "[format('{0}-{1}-app', parameters('namePrefix'), parameters('environmentName'))]",
    "generatedJobName": "[format('{0}-{1}-migrate', parameters('namePrefix'), parameters('environmentName'))]",
    "generatedPostgresName": "[take(format('{0}-{1}-pg-{2}', parameters('namePrefix'), parameters('environmentName'), variables('suffix')), 63)]",
