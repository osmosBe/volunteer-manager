    "workspaceName": "[format('{0}-{1}-logs', parameters('namePrefix'), parameters('environmentName'))]",
    "tags": {
      "application": "volunteer-manager",
      "environment": "[parameters('environmentName')]",
      "managedBy": "bicep"
    },
    "selectedRegistryName": "[if(empty(parameters('existingContainerRegistryName')), variables('generatedRegistryName'), parameters('existingContainerRegistryName'))]",
    "selectedContainerAppName": "[if(empty(parameters('existingContainerAppName')), variables('generatedAppName'), parameters('existingContainerAppName'))]"
